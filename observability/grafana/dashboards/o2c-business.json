    {
      "type": "timeseries",
      "title": "LLM cost per order per day",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "o2c-analytics"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "o2c-analytics"
          },
          "rawSql": "select date_day::timestamp as time, sum(cost_usd) filter (where key_alias in ('classifier', 'extractor', 'agent')) / nullif(max(orders), 0) as cost_per_order from analytics.mart_llm_cost where $__timeFilter(date_day) group by date_day order by 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {},
      "id": 9
