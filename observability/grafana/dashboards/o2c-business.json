      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "o2c-analytics"
          },
          "rawSql": "select sum(cost_usd) filter (where key_alias in ('classifier', 'extractor', 'agent')) / nullif((select count(*) from analytics.fct_orders where $__timeFilter(extracted_at)), 0) from analytics.mart_llm_cost where $__timeFilter(date_day)",
