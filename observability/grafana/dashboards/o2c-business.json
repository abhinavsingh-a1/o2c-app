    {
      "type": "stat",
      "title": "LLM cost per order",
      "description": "Cost of the classifier, extractor and agent keys / orders.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "o2c-analytics"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
