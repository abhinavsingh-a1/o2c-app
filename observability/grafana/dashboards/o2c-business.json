    {
      "type": "stat",
      "title": "Touchless rate",
      "description": "Posted without any review decision / orders the agent decided.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "o2c-analytics"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
