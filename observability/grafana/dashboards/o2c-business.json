      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "o2c-analytics"
          },
          "rawSql": "select count(*) filter (where touchless)::numeric / nullif(count(*) filter (where decision is not null), 0) from analytics.fct_orders where $__timeFilter(extracted_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
