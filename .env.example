# Per-service LiteLLM virtual keys with monthly budgets: after `make up`, run
# `uv run python ml/litellm_keys.py`, paste the printed keys here and run `make up` again.
# An empty value falls back to LITELLM_MASTER_KEY (docker-compose.yml, ml/litellm_common.py).
LITELLM_KEY_CLASSIFIER=sk-replace-me
LITELLM_KEY_EXTRACTOR=sk-replace-me
LITELLM_KEY_AGENT=sk-replace-me
LITELLM_KEY_EVAL=sk-replace-me
# Grafana admin (http://localhost:3001, user admin)
GRAFANA_ADMIN_PASSWORD=replace-me
