# Copy to .env (git-ignored) and replace every replace-me.
# Values with special characters ($ # \ " spaces): put them in single quotes, e.g.
#   LANGFUSE_ADMIN_PASSWORD='p#ss$word'
# docker compose, `uv run --env-file .env` (make dbt-build) and pydantic-settings read
# single-quoted values literally, but unquoted or double-quoted $ and # differently.
# POSTGRES_PASSWORD goes into database URLs: avoid @ : / ? # % in it.
# Check with: uv run python ml/check_env.py (prints line numbers and keys, never values)
POSTGRES_USER=o2c
POSTGRES_PASSWORD=replace-me
S3_ACCESS_KEY=local
S3_SECRET_KEY=replace-me
OPENAI_API_KEY=sk-replace-me
LITELLM_MASTER_KEY=sk-local-master-replace-me
LANGFUSE_SALT=replace-me
LANGFUSE_ENCRYPTION_KEY=replace-me
LANGFUSE_NEXTAUTH_SECRET=replace-me
REDIS_AUTH=replace-me
CLICKHOUSE_PASSWORD=replace-me
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_ADMIN_EMAIL=you@example.com
LANGFUSE_ADMIN_PASSWORD=replace-me
ERP_DATABASE_URL=postgresql+psycopg://o2c:replace-me@localhost:5432/erp
INTAKE_HMAC_SECRET=replace-me
EVENTS_DATABASE_URL=postgresql+psycopg://o2c:replace-me@localhost:5432/o2c
AUTH_JWT_SECRET=replace-me
# Per-service LiteLLM virtual keys with monthly budgets: after `make up`, run
# `uv run python ml/litellm_keys.py`, paste the printed keys here and run `make up` again.
# An empty value falls back to LITELLM_MASTER_KEY (docker-compose.yml, ml/litellm_common.py).
LITELLM_KEY_CLASSIFIER=sk-replace-me
LITELLM_KEY_EXTRACTOR=sk-replace-me
LITELLM_KEY_AGENT=sk-replace-me
LITELLM_KEY_EVAL=sk-replace-me
# Grafana admin (http://localhost:3001, user admin)
GRAFANA_ADMIN_PASSWORD=replace-me
# Read-only Postgres role for Grafana's analytics datasource (SELECT on schema analytics)
GRAFANA_DB_PASSWORD=replace-me
